Clayton_Copula
setwd("~/SSReliabilityClaytonMWD/R")
Clayton_Copula
#' u <- c(0.2, 0.5, 0.8)
#' v <- c(0.3, 0.6, 0.9)
#'
#' Clayton_Copula(u, v, theta = 2)
#' Clayton_Copula_pdf(u, v, theta = 2)
#'
#' @references
#' Nelsen, R. B. (2006). \emph{An Introduction to Copulas}. Springer.
#'
#' @export
Clayton_Copula_pdf <- function(u, v, theta) {
if(theta <= 0) return(rep(0, length(u)))
eps <- 1e-10
u <- pmin(pmax(u, eps), 1 - eps)
v <- pmin(pmax(v, eps), 1 - eps)
p <- (theta + 1) * (u * v)^(-(theta + 1)) *
(u^(-theta) + v^(-theta) - 1)^(-2 - 1/theta)
return(p)
}
source("Clayton.Copula.R")
u <- c(0.2, 0.5, 0.8)
v <- c(0.3, 0.6, 0.9)
Clayton_Copula(u, v, theta = 2)
Clayton_Copula_pdf(u, v, theta = 2)
u
Clayton_Copula
Clayton_Copula(u, v, theta = 2)
Clayton_Copula(u=1, v=2, theta = 2)
Clayton_Copula(u=1, v=20, theta = 2)
Clayton_Copula(u=10, v=2, theta = 2)
Clayton_Copula(u=10, v=5, theta = 2)
Clayton_Copula(u=10, v=1.5, theta = 2)
#' u <- c(0.2, 0.5, 0.8)
#' v <- c(0.3, 0.6, 0.9)
#'
#' Clayton_Copula(u, v, theta = 2)
#' Clayton_Copula_pdf(u, v, theta = 2)
#'
#' @references
#' Nelsen, R. B. (2006). \emph{An Introduction to Copulas}. Springer.
#'
#' @export
Clayton_Copula <- function(u, v, theta) {
if (any(u < 0 | u > 1)) stop("u must be in [0,1]")
if (any(v < 0 | v > 1)) stop("v must be in [0,1]")
if (theta <= 0) stop("theta must be > 0")
if(theta == 0) return(u * v) # Independent case
return( pmax( u^(-theta) + v^(-theta) - 1, 0)^(-1/theta) )
}
Clayton_Copula(u=10, v=1.5, theta = 2)
Clayton_Copula_pdf
Clayton_Copula_pdf(u, v, theta = 2)
Clayton_Copula_pdf(u=c(1,3), v=c(0.4,0.8), theta = 2)
Clayton_Copula_pdf(u=c(1,3), v=c(0.4), theta = 2)
#'
#' @rdname Clayton_Copula
#' @export
Clayton_Copula_pdf <- function(u, v, theta) {
if (any(u < 0 | u > 1)) stop("u must be in [0,1]")
if (any(v < 0 | v > 1)) stop("v must be in [0,1]")
if (theta <= 0) stop("theta must be > 0")
if(theta <= 0) return(rep(0, length(u)))
eps <- 1e-10
u <- pmin(pmax(u, eps), 1 - eps)
v <- pmin(pmax(v, eps), 1 - eps)
p <- (theta + 1) * (u * v)^(-(theta + 1)) *
(u^(-theta) + v^(-theta) - 1)^(-2 - 1/theta)
return(p)
}
Clayton_Copula_pdf(u=c(1,3), v=c(0.4), theta = 2)
